# Скопируйте этот файл в .env и заполните своими значениями для локальной разработки.
# На Render эти переменные (кроме локальных особенностей вроде PGSSL) задаёт render.yaml —
# см. README → «Деплой на Render».

# Строка подключения к Postgres. Локально, например:
# postgresql://postgres:postgres@localhost:5432/marketradar
DATABASE_URL=

# Для локального Postgres без SSL раскомментируйте:
# PGSSL=false

# Порт, на котором будет работать сервис
PORT=3000

# Секрет для подписи сессий (любая длинная случайная строка)
SESSION_SECRET=change-me-to-a-long-random-string

# Секрет для шифрования сохранённых API-токенов Wildberries в базе (32+ символов)
APP_SECRET=change-me-to-a-long-random-string-too

# "Цену на сайте" (после скидки продавца и после СПП) сервис получает через
# управляемый браузер (Playwright) за резидентным/мобильным прокси — см. README →
# «Откуда берутся две цены». Без прокси эта часть просто не будет работать (в
# продуктах будет пусто в колонках "Цена на сайте"/"СПП"), остальное не сломается.
#
# Формат — как выдают такие сервисы (LTE.Center и подобные): host:port:логин:пароль,
# несколько прокси через запятую (используются по очереди, см. SCRAPE_ROTATE_EVERY).
#
# ВАЖНО: указывайте именно ХОСТ (например msk-10.lte-center.ru), а не конкретный IP —
# мобильные прокси автоматически меняют IP за этим хостом каждые несколько минут
# (ротация), сам хост при этом не меняется. Если подставить сюда IP, который был
# актуален в момент проверки, он довольно быстро перестанет быть текущим и все запросы
# начнут проваливаться (проверено вживую — именно так один раз и сломалось).
# RESIDENTIAL_PROXIES=msk-10.lte-center.ru:2018:username:password

# Пауза между товарами при получении цены на сайте (мс) — не убирайте и не уменьшайте
# сильно, это защита от того, чтобы не выглядеть ботом для Wildberries.
# SCRAPE_DELAY_MS=5000

# Через сколько товаров менять прокси (если их несколько в RESIDENTIAL_PROXIES).
# SCRAPE_ROTATE_EVERY=15

# Автосинхронизация всех подключённых аккаунтов каждые N минут.
# 0 — выключить автосинхронизацию, обновлять только вручную кнопкой "Синхронизировать".
AUTO_SYNC_MINUTES=0

# Восстановление пароля отправляет письмо через Resend (resend.com) — продавцу ничего
# заводить не нужно, ключ и адрес отправителя настраивает оператор сервиса. Без
# RESEND_API_KEY кнопка "Забыли пароль?" не сломает сайт, но письма не будут уходить
# (см. README → «Восстановление пароля»).
# RESEND_API_KEY=re_...
# MAIL_FROM=MarketRadar <onboarding@resend.dev>

